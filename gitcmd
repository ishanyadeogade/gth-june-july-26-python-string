

clone 
=====
cd /d D:\Workspace\workspace-vsc
git clone https://github.com/ishanyadeogade/gth-june-july-26-python-string.git
cd gth-june-july-26-python-string






$ErrorActionPreference = "Stop"

$projectPath = "D:\Workspace\workspace-vsc\gth-june-july-26-python-string"
$remote = "https://github.com/ishanyadeogade/gth-june-july-26-python-string.git"

# 1. Enter project
Set-Location $projectPath

# 2. Verify Git repository
if (-not (Test-Path ".git")) {
    git init
    if ($LASTEXITCODE -ne 0) { throw "Git init failed" }
}

# 3. Configure main branch
git branch -M main
if ($LASTEXITCODE -ne 0) { throw "Branch setup failed" }

# 4. Add all project files and folders
git add -A
if ($LASTEXITCODE -ne 0) { throw "Git add failed" }

# 5. Commit changes if there are staged files
git diff --cached --quiet

if ($LASTEXITCODE -eq 1) {
    git commit -m "python string practice"
    if ($LASTEXITCODE -ne 0) { throw "Commit failed" }
}

if ($LASTEXITCODE -gt 1) {
    throw "Git diff failed"
}

# 6. Add origin if it does not exist
$originExists = git remote | Where-Object { $_ -eq "origin" }

if (-not $originExists) {
    git remote add origin $remote
    if ($LASTEXITCODE -ne 0) { throw "Adding remote failed" }
}

# 7. Correct origin URL
git remote set-url origin $remote
if ($LASTEXITCODE -ne 0) { throw "Setting remote failed" }

# 8. Verify remote
Write-Host "`nConfigured remote:" -ForegroundColor Cyan
git remote -v

# 9. Push to GitHub
git push -u origin main

if ($LASTEXITCODE -ne 0) {
    throw "Push failed. Check the Git error above."
}

Write-Host "`nSUCCESS: GitHub push completed!" -ForegroundColor Green
